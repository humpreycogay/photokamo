+#[allow(clippy::too_many_arguments)]
+fn cmd_lut(
+    film_name: &str,
+    paper_name: Option<&str>,
+    scan_film: bool,
+    params_file: Option<&Path>,
+    meter: Option<&Path>,
+    size: u32,
+    output: &Path,
+    data_dir: &Path,
+) -> Result<()> {
+    use spektrafilm_core::stages::filming::{input_colorspace_to_xyz, measure_autoexposure_ev};
+    let start = Instant::now();
+    let film = profile::load_profile_by_name(data_dir, film_name)
+        .with_context(|| format!("loading film profile: {film_name}"))?;
+    let print_stock = if scan_film {
+        film_name.to_string()
+    } else if let Some(p) = paper_name {
+        p.to_string()
+    } else if let Some(ref target) = film.info.target_print {
+        target.clone()
+    } else {
+        bail!("no paper specified and film has no target_print");
+    };
+    let print = profile::load_profile_by_name(data_dir, &print_stock)
+        .with_context(|| format!("loading print profile: {print_stock}"))?;
+
+    let mut params: RuntimeParams = if let Some(pf) = params_file {
+        let f = std::fs::File::open(pf).with_context(|| format!("opening params file: {}", pf.display()))?;
+        serde_json::from_reader(std::io::BufReader::new(f)).with_context(|| "parsing params file")?
+    } else {
+        RuntimeParams::default()
+    };
+    params.io.scan_film = scan_film;
+
+    // Meter auto-exposure like a full render of the same image would. The filming
+    // stage applies it as a linear gain *before* exposure compensation (which the
+    // enlarger may compensate for), so bake it into the grid the same way.
+    let mut ae_gain = 1.0f32;
+    if params.camera.auto_exposure {
+        if let Some(m) = meter {
+            let image = load_image(m)?; // PNG → linear sRGB
+            let ev = measure_autoexposure_ev(&image, &input_colorspace_to_xyz("sRGB"), &params.camera.auto_exposure_method);
+            ae_gain = 2.0f32.powf(ev);
+            eprintln!("Auto exposure: {ev:+.4} EV");
+        }
+        params.camera.auto_exposure = false;
+    }
+
+    // Colour only: switch off everything spatial so grid samples don't mix.
+    params.film_render.grain.active = false;
+    params.film_render.halation.active = false;
+    params.film_render.glare.active = false;
+    params.film_render.dir_couplers.diffusion_size_um = 0.0;
+    params.film_render.dir_couplers.diffusion_tail_weight = 0.0;
+    params.camera.lens_blur_um = 0.0;
+    params.camera.diffusion_filter.active = false;
+    params.enlarger.lens_blur = 0.0;
+    params.enlarger.diffusion_filter.active = false;
+    params.scanner.lens_blur = 0.0;
+    params.scanner.unsharp_mask = [0.0, 0.0];
+    // Grid values are sRGB-encoded like browser pixels; decode them exactly as
+    // `load_png` does for `process`, so both paths see identical linear input.
+    params.io.input_color_space = "sRGB".to_string();
+    params.io.input_cctf_decoding = false;
+
+    let pipeline = Pipeline::new_with_spectral(film, print, params, data_dir)
+        .map_err(|e| anyhow::anyhow!("spectral pipeline: {e}"))?;
+    let s = size as usize;
+    let step = 1.0 / (s - 1) as f32;
+    let mut data = Vec::with_capacity(s * s * s * 3);
+    for bi in 0..s {
+        for gi in 0..s {
+            for ri in 0..s {
+                for v in [ri, gi, bi] {
+                    let linear = spektrafilm_math::precision::srgb_decode(spektrafilm_math::precision::from_f32(v as f32 * step));
+                    data.push(linear * spektrafilm_math::precision::from_f32(ae_gain));
+                }
+            }
+        }
+    }
+    let grid = ImageBuf::from_data((s * s) as _, s as _, data);
+    let backend = spektrafilm_gpu::select_backend();
+    let out = pipeline.process(grid, backend.as_ref());
+    let mut bytes = Vec::with_capacity(out.data.len() * 4);
+    for &v in out.data.iter() {
+        bytes.extend_from_slice(&(v as f32).to_le_bytes());
+    }
+    std::fs::write(output, &bytes).with_context(|| format!("writing LUT: {}", output.display()))?;
+    eprintln!("LUT {s}^3: {} ms", start.elapsed().as_millis());
+    Ok(())
+}
+
 fn bytemuck_cast_f64_to_bytes(v: &[f64]) -> &[u8] {
     unsafe { std::slice::from_raw_parts(v.as_ptr() as *const u8, std::mem::size_of_val(v)) }
 }
