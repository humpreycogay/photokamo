# Keep patches and build scripts (incl. the archived spektrafilm-rs ones) byte-exact on every platform.
*.patch text eol=lf
*.sh    text eol=lf

# Engine source copies: store byte-for-byte as upstream has them (no line-ending conversion),
# so updates from upstream merge cleanly.
engines/*/src/** -text
engines/*/runtime/** -text
Archive/engines/*/src/** -text
Archive/engines/*/runtime/** -text

# Binary engine artifacts and data
*.wasm  binary
*.npy   binary
*.woff2 binary
